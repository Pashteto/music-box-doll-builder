# Production env for docker-compose.prod.yml. Copy to `.env` on the server and
# fill in a STRONG generated DB password. NEVER commit the real .env.
#   cp .env.prod.example .env && chmod 600 .env
# (.env and *.env are gitignored/dockerignored.)
DB_USER=dollbuilder
DB_NAME=dollbuilder
DB_PASSWORD=__CHANGE_ME__   # generate: openssl rand -base64 32

# Stripe (Plan 3 / E12) — TEST-mode keys from the Stripe dashboard. Leave blank to
# keep checkout disabled (GET /entitlements + mock-checkout still work; /checkout/session
# returns 503). NEVER commit real keys.
STRIPE_SECRET_KEY=        # sk_test_...
STRIPE_WEBHOOK_SECRET=    # whsec_... (from the webhook endpoint you register in Stripe)
STRIPE_PRICE_ID=          # price_... (one-time-payment product price)
